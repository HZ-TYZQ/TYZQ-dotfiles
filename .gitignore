# 适用于本机的changelog, 不放入整体配置变更

/docs/本机系统变更记录

# Keep personal Git and npm configuration local.
/home/dot_gitconfig
/home/dot_config/git/config
/home/dot_config/npm/npmrc
/home/dot_config/npm/private_npmrc

# Claude Code: keep account details, credentials, and runtime data local.
/home/dot_claude*
/home/private_dot_claude*
/home/dot_config/claude/
/home/dot_config/private_claude/*
!/home/dot_config/private_claude/settings.json
!/home/dot_config/private_claude/executable_statusline-command.sh

# Local working files; review explicit paths before staging.
__pycache__/
*.pyc
*.swp
*.swo
*~

# Private configuration files

private_dot_local/
