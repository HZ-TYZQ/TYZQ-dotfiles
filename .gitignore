# 适用于本机的changelog, 不放入整体配置变更

/docs/本机系统变更记录

# Git identity comes from local chezmoi data; never commit a rendered copy.
/home/dot_gitconfig
/home/dot_config/git/config

# Claude Code is not managed.
/home/dot_claude*
/home/private_dot_claude*
/home/dot_config/claude/
/home/dot_config/private_claude/
/home/dot_config/environment.d/80-claude.conf
/home/dot_config/fish/conf.d/40-claude.fish

# Noctalia GUI settings name personal wallpaper and avatar files; kept local by choice.
/home/private_dot_local/state/noctalia/
# Third-party Fcitx5 themes: bed-money's source material forbids commercial use
# and AI training, and OriDark is another author's work; do not republish them.
/home/private_dot_local/private_share/private_fcitx5/themes/

# Local working files; review explicit paths before staging.
__pycache__/
*.pyc
*.swp
*.swo
*~
